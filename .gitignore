# ==============================================================================
# STREETFLOW LIVE — Git Ignore Rules
# ==============================================================================

# ── Environment & Local Secrets (NEVER commit these) ───────────────────────────
.env
.env.*
!.env.example
*.env

# ── Service Accounts & Credential JSON Files ──────────────────────────────────
serviceAccountKey.json
firebase-adminsdk*.json
*service-account*.json
*service_account*.json
*credentials*.json
*secret*.json
*.key
*.p12
*.pfx

# ── AWS & SSH Credentials ─────────────────────────────────────────────────────
*.pem
*.ppk
*accessKeys.csv
*_accessKeys.csv
aws-credentials*
.aws/
streetflow-key.pem
deploy/streetflow-key.pem
deploy/*.pem

# ── Python / Virtual Environments ─────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/
.venv/
venv/
venv_new/
traffic_env/

# ── OS & IDE Temporary Files ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/

# ── Large Data & Model Artifacts ──────────────────────────────────────────────
*.npy
*.pt
*.pth
*.ckpt
*.h5
*.zip
*.db
*.joblib
data/*.db
data/raw/
api/data/
model/data/

# ── Evaluation Outputs (generated by model/evaluate_bangalore.py) ─────────────
model/results.json
model/training_log.csv
model/training_curve.png
model/error_vs_horizon.png
model/predicted_vs_observed.png

# ── Firebase CLI Temporary Logs & Cache ───────────────────────────────────────
.firebase/
firebase-debug.log
firebase-debug.*.log
ui-debug.log

# ── Frontend Duplicated Assets ────────────────────────────────────────────────
frontend/bangalore_road_locations.csv

# ── Logs & Misc Temporary Files ───────────────────────────────────────────────
*.log
nohup.out

# ── Testing ───────────────────────────────────────────────────────────────────
.pytest_cache/
htmlcov/
.coverage

# NOTE: Legitimate project configuration files MUST remain tracked:
#       firebase.json, database.rules.json, firestore.rules,
#       firestore.indexes.json, deploy/cf-config.json, dataconnect/
