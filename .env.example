# ==============================================================================
# STREETFLOW LIVE — Environment & Configuration Template (.env.example)
#
# Copy this file to '.env' for local development.
# NEVER commit the actual '.env' file or any real secret credentials to Git.
# ==============================================================================

# ── Backend / API Configuration ───────────────────────────────────────────────
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=https://traff2ic-detector.web.app,http://localhost:8000

# ── Firebase Web App Public Configuration (Safe for Client Browser) ───────────
FIREBASE_PROJECT_ID=traff2ic-detector
FIREBASE_AUTH_DOMAIN=traff2ic-detector.firebaseapp.com
FIREBASE_DATABASE_URL=https://traff2ic-detector-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_STORAGE_BUCKET=traff2ic-detector.firebasestorage.app

# ── reCAPTCHA v3 Public Site Key (Browser Client Only) ────────────────────────
# Put your public site key here (NOT the secret key)
RECAPTCHA_V3_SITE_KEY=YOUR_RECAPTCHA_V3_SITE_KEY
